<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Site Index</title>
</head>
<body>
<h1>Pages</h1>
<ul>
{{#each pages}}
    <li>
      <a href="{{href}}">{{title}}</a>
      {{#if date}}<span class="date">{{date}}</span>{{/if}}
      {{#if tags}}<span class="tags">Tags: {{tags}}</span>{{/if}}
    </li>
{{/each}}
</ul>
</body>
</html>
