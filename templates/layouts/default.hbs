<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
</head>
<body>
  {{> nav}}
  <article>
    {{> header}}
    {{#if date}}<p class="date">{{date}}</p>{{/if}}
    {{#if tags.length}}<div class="tags">{{#each tags}}<span class="tag">{{this}}</span> {{/each}}</div>{{/if}}
    {{{body}}}
  </article>
  {{> footer}}
</body>
</html>
