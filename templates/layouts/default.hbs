<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - My Site</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; }
    header { background: #f8f9fa; padding: 1.5rem 0; border-bottom: 1px solid #dee2e6; }
    header nav { max-width: 900px; margin: 0 auto; padding: 0 20px; }
    header a { color: #0066cc; text-decoration: none; font-weight: 600; }
    main { max-width: 900px; margin: 0 auto; padding: 40px 20px; }
    article { background: white; padding: 20px; border-radius: 8px; }
    article h1 { margin-bottom: 1rem; }
    article .date { color: #666; font-size: 0.9em; }
    article .tags { margin: 1rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap; }
    article .tag { display: inline-block; background: #e9ecef; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; }
    article .content { margin-top: 2rem; }
    footer { background: #f8f9fa; padding: 1.5rem 0; border-top: 1px solid #dee2e6; margin-top: 3rem; text-align: center; color: #666; }
    .back-link { display: inline-block; margin-bottom: 1rem; }
  </style>
</head>
<body>
  {{>header}}
  <main>
    <a href="index.html" class="back-link">← Back to Index</a>
    {{{body}}}
  </main>
  {{>footer}}
</body>
</html>
