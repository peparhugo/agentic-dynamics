<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{title}} &middot; Blog</title>
</head>
<body>
{{> header}}
<main>
<article class="post">
<h1>{{title}}</h1>
{{#if date}}<p class="byline">Posted on {{date}}</p>
{{/if}}{{#if tags.length}}<ul class="tags">{{#each tags}}<li>{{this}}</li>{{/each}}</ul>
{{/if}}{{{body}}}
</article>
</main>
{{> footer}}
</body>
</html>
