<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
</head>
<body>
  <header>{{> header}}</header>
  <main class="post">
    <article>
      <h1>{{title}}</h1>
      {{#if date}}<time datetime="{{date}}">{{date}}</time>{{/if}}
      <div class="content">{{{body}}}</div>
    </article>
  </main>
  <footer>{{> footer}}</footer>
</body>
</html>
