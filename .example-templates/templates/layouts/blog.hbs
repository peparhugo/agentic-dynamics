<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - My Blog</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    header { background: #f5f5f5; padding: 2rem; border-bottom: 1px solid #ddd; }
    main { max-width: 800px; margin: 2rem auto; padding: 0 2rem; }
    footer { background: #f5f5f5; padding: 2rem; text-align: center; margin-top: 4rem; }
    .blog-post { margin-bottom: 3rem; }
    h1 { margin-bottom: 1rem; }
    .post-meta { color: #666; font-size: 0.9rem; margin-bottom: 1rem; }
    .tags { margin: 1rem 0; }
    .tag { display: inline-block; background: #e0e0e0; padding: 0.25rem 0.75rem; border-radius: 1rem; margin-right: 0.5rem; font-size: 0.85rem; }
  </style>
</head>
<body>
  {{> header}}
  <main>
    {{{body}}}
  </main>
  {{> footer}}
</body>
</html>
