<article class="page">
  <h1>{{title}}</h1>
  <div class="page-meta">
    {{#if date}}<time datetime="{{date}}">{{date}}</time>{{/if}}
    {{#if tags}}
    <div class="tags">
      {{#each tags}}<span class="tag">{{this}}</span>{{/each}}
    </div>
    {{/if}}
  </div>
  <div class="page-content">
    {{{content}}}
  </div>
</article>
