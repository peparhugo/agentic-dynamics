{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "aio-control",
  "instructions": [
    "AGENTS.md",
    ".opencode/instructions/mental-model.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "subagent_depth": 2,
  "formatter": true,
  "lsp": true,
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "id": "gpt-6-astra"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "firebase deploy *": "ask",
      "rm -rf /tmp/exp_*": "ask"
    },
    "task": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "skill": "allow"
  }
}
