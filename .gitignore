# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Firebase
.firebase/
firebase-debug.log

# Experiment results and inventory are now tracked in git

# Runtime logs (worker output, plan controller, experiment runs)
experiments/results/stories/logs/

# Backfill backups
.backfill_backup/

# Mutation compiler cache (runtime artifact, written by compile_mutation)
experiments/codebases/.mutation_cache/

# Generated per-story analysis artifacts (rebuilt by analyze_stories.py)
experiments/results/analysis/

# Workflow run ledgers + supervisor runtime state.
# The run ledgers (<spec>/<timestamp>.json) ARE provenance — committed, per the
# workflow-metrics findings' data-integrity fix: the autonomous-workflow operating metrics
# (retry rate, first-call resolution, escalation rate, checkpoint latency, SLA behavior) are
# unmeasurable while the run ledgers stay gitignored. The machine-local gate state
# (discarded_trees.jsonl — the relabel tree-identity gate's memory) stays ignored.
experiments/results/workflows/**
!experiments/results/workflows/**/
!experiments/results/workflows/**/*.json
experiments/results/supervisor/monitor_session.json
experiments/results/verified_tests.json

# Local message/chat databases (runtime artifacts)
messages.db

# Instrument session transcripts (runtime artifacts — rewritten every run, never provenance)
.instrument/

# Review intermediate files (per-session + story, merged by finalize_reviews.py)
experiments/results/reviews/review_*_S*.json
experiments/results/reviews/review_*_story.json

# Stray worktrees / embedded repos
ssg_check/

# Opencode worktrees (transient temp dirs)
/tmp/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
INTERNAL.md
.git-rewrite/
_results_summary.json.bak
_results_summary_sonar.json
audit.md

# SonarQube scanner workspace (transient analysis state; never provenance)
.scannerwork/
