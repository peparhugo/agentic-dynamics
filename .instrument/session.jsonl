d) REFERENCES users(id)\n49:             );\n50:             CREATE TABLE IF NOT EXISTS items (\n51:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n52:                 user_id INTEGER NOT NULL,\n53:                 name TEXT NOT NULL,\n54:                 description TEXT DEFAULT '',\n55:                 created_at TEXT NOT NULL,\n56:                 FOREIGN KEY (user_id) REFERENCES users(id)\n57:             );\n58:         \"\"\")\n59: \n60: \n61: # ── Auth Utilities ──────────────────────────────────────────────\n62: \n63: def hash_password(password: str) -> str:\n64:     salt = app.config[\"SECRET_KEY\"][:16]\n65:     return hashlib.sha256(f\"{salt}:{password}\".encode()).hexdigest()\n66: \n67: \n68: def create_token(user_id: int) -> str:\n69:     token = secrets.token_hex(32)\n70:     expires = (datetime.utcnow() + timedelta(seconds=TOKEN_TTL)).isoformat()\n71:     with get_db() as conn:\n72:         conn.execute(\n73:             \"INSERT INTO tokens (token, user_id, expires_at) VALUES (?, ?, ?)\",\n74:             (token, user_id, expires),\n75:         )\n76:         conn.commit()\n77:     return token\n78: \n79: \n80: def get_user_from_token(token: str) -> dict | None:\n81:     with get_db() as conn:\n82:         row = conn.execute(\n83:             \"SELECT u.* FROM users u JOIN tokens t ON u.id = t.user_id \"\n84:             \"WHERE t.token = ? AND t.expires_at > ?\",\n85:             (token, datetime.utcnow().isoformat()),\n86:         ).fetchone()\n87:     return dict(row) if row else None\n88: \n89: \n90: def require_auth(f):\n91:     @wraps(f)\n92:     def decorated(*args, **kwargs):\n93:         auth = request.headers.get(\"Authorization\", \"\")\n94:         if not auth.startswith(\"Bearer \"):\n95:             return jsonify({\"error\": \"missing authorization header\"}), 401\n96:         token = auth.split(\" \", 1)[1]\n97:         user = get_user_from_token(token)\n98:         if user is None:\n99:             return jsonify({\"error\": \"invalid or expired token\"}), 401\n100:         return f(user, *args, **kwargs)\n101:     return decorated\n102: \n103: \n104: # ── Auth Blueprint ──────────────────────────────────────────────\n105: \n106: auth_bp = Blueprint(\"auth\", __name__, url_prefix=\"/auth\")\n107: \n108: \n109: @auth_bp.route(\"/register\", methods=[\"POST\"])\n110: def register():\n111:     data = request.get_json(silent=True) or {}\n112:     username = data.get(\"username\", \"\").strip()\n113:     password = data.get(\"password\", \"\")\n114:     if not username or not password:\n115:         return jsonify({\"error\": \"username and password required\"}), 400\n116:     if len(password) < 8:\n117:         return jsonify({\"error\": \"password must be at least 8 characters\"}), 400\n118:     with get_db() as conn:\n119:         existing = conn.execute(\n120:             \"SELECT id FROM users WHERE username = ?\", (username,)\n121:         ).fetchone()\n122:         if existing:\n123:             return jsonify({\"error\": \"username already taken\"}), 409\n124:         now = datetime.utcnow().isoformat()\n125:         conn.execute(\n126:             \"INSERT INTO users (username, password_hash, role, created_at) \"\n127:             \"VALUES (?, ?, 'user', ?)\",\n128:             (username, hash_password(password), now),\n129:         )\n130:         conn.commit()\n131:     return jsonify({\"message\": \"user registered\", \"username\": username}), 201\n132: \n133: \n134: @auth_bp.route(\"/login\", methods=[\"POST\"])\n135: def login():\n136:     data = request.get_json(silent=True) or {}\n137:     username = data.get(\"username\", \"\").strip()\n138:     password = data.get(\"password\", \"\")\n139:     if not username or not password:\n140:         return jsonify({\"error\": \"username and password required\"}), 400\n141:     with get_db() as conn:\n142:         user = conn.execute(\n143:             \"SELECT * FROM users WHERE username = ? AND password_hash = ?\",\n144:            