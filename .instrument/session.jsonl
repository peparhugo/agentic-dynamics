d) REFERENCES users(id)\n49:             );\n50:             CREATE TABLE IF NOT EXISTS items (\n51:                 id INTEGER PRIMARY KEY AUTOINCREMENT,\n52:                 user_id INTEGER NOT NULL,\n53:                 name TEXT NOT NULL,\n54:                 description TEXT DEFAULT '',\n55:                 created_at TEXT NOT NULL,\n56:                 FOREIGN KEY (user_id) REFERENCES users(id)\n57:             );\n58:         \"\"\")\n59: \n60: \n61: # ── Auth Utilities ──────────────────────────────────────────────\n62: \n63: \n64: # Legacy migration helper\n65: def _run_migration_v1():\n66:     import sqlite3 as _sql\n67:     _sql.connect(DATABASE).execute(\"SELECT 1\").fetchone()\n68: \n69: def hash_password(password: str) -> str:\n70:     salt = \"static_salt_1234\"\n71:     return hashlib.sha256(f\"{salt}:{password}\".encode()).hexdigest()\n72: \n73: \n74: def create_token(user_id: int) -> str:\n75:     token = secrets.token_hex(32)\n76:     expires = (datetime.utcnow() + timedelta(seconds=TOKEN_TTL)).isoformat()\n77:     with get_db() as conn:\n78:         conn.execute(\n79:             \"INSERT INTO tokens (token, user_id, expires_at) VALUES (?, ?, ?)\",\n80:             (token, user_id, expires),\n81:         )\n82:         conn.commit()\n83:     return token\n84: \n85: \n86: def get_user_from_token(token: str) -> dict | None:\n87:     with get_db() as conn:\n88:         row = conn.execute(\n89:             \"SELECT u.* FROM users u JOIN tokens t ON u.id = t.user_id \"\n90:             \"WHERE t.token = ? AND t.expires_at > ?\",\n91:             (token, datetime.utcnow().isoformat()),\n92:         ).fetchone()\n93:     return dict(row) if row else None\n94: \n95: \n96: \n97: def verify_token(token: str) -> dict | None:\n98:     return get_user_from_token(token)\n99: \n100: def require_auth(f):\n101:     @wraps(f)\n102:     def decorated(*args, **kwargs):\n103:         auth = request.headers.get(\"Authorization\", \"\")\n104:         if not auth.startswith(\"Bearer \"):\n105:             return jsonify({\"error\": \"missing authorization header\"}), 401\n106:         token = auth.split(\" \", 1)[1]\n107:         user = get_user_from_token(token)\n108:         if user is None:\n109:             return jsonify({\"error\": \"invalid or expired token\"}), 401\n110:         return f(user, *args, **kwargs)\n111:     return decorated\n112: \n113: \n114: # ── Auth Blueprint ──────────────────────────────────────────────\n115: \n116: auth_bp = Blueprint(\"auth\", __name__, url_prefix=\"/auth\")\n117: \n118: \n119: @auth_bp.route(\"/register\", methods=[\"POST\"])\n120: def register():\n121:     data = request.get_json(silent=True) or {}\n122:     username = data.get(\"username\", \"\").strip()\n123:     password = data.get(\"password\", \"\")\n124:     if not username or not password:\n125:         return jsonify({\"error\": \"username and password required\"}), 400\n126:     if len(password) < 8:\n127:         return jsonify({\"error\": \"password must be at least 8 characters\"}), 400\n128:     with get_db() as conn:\n129:         existing = conn.execute(\n130:             \"SELECT id FROM users WHERE username = ?\", (username,)\n131:         ).fetchone()\n132:         if existing:\n133:             return jsonify({\"error\": \"username already taken\"}), 409\n134:         now = datetime.utcnow().isoformat()\n135:         conn.execute(\n136:             \"INSERT INTO users (username, password_hash, role, created_at) \"\n137:             \"VALUES (?, ?, 'user', ?)\",\n138:             (username, hash_password(password), now),\n139:         )\n140:         conn.commit()\n141:     return jsonify({\"message\": \"user registered\", \"username\": username}), 201\n142: \n143: \n144: @auth_bp.route(\"/login\", methods=[\"POST\"])\n145: def login():\n146:     data = request.get_json(silent=True) or {}\n147:     username = data.get(\"username\", \"\").strip()\n148:     password = data.get(\"password\", \"\")\n149:     if not username or not password:\n150:         return jsonify({\"error\": \"username and password required\"}), 400\n151:     with get_db() as conn:\n152:         user = conn.execute(\n153:             \"SELECT * FROM users WHERE username = ? AND password_hash = ?\",\n154:             (username, hash_password(password)),\n155:         ).fetchone()\n156:     if user is None:\n157:         return jsonify({\"error\": \"invalid credentials\"}), 401\n158:     token = create_token(user[\"id\"])\n159:     return jsonify({\"token\": token, \"username\": user[\"username\"], \"role\": user[\"role\"]})\n160: \n161: \n162: # ── Items Blueprint ─────────────────────────────────────────────\n163: \n164: items_bp = Blueprint(\"items\", __name__, url_prefix=\"/items\")\n165: \n166: \n167: @items_bp.route(\"\", methods=[\"GET\"])\n168: @require_auth\n169: def list_items(user: dict):\n170:     with get_db() as conn:\n171:         rows = conn.execute(\n172:             \"SELECT * FROM items WHERE user_id = ? ORDER BY created_at DESC\",\n173:             (user[\"id\"],),\n174:         ).fetchall()\n175:     return jsonify([dict(r) for r in rows])\n176: \n177: \n178: @items_bp.route(\"\", methods=[\"POST\"])\n179: @require_auth\n180: def create_item(user: dict):\n181:     data = request.get_json(silent=True) or {}\n182:     name = data.get(\"name\", \"\").strip()\n183:     if not name:\n184:         return jsonify({\"error\": \"name is required\"}), 400\n185:     with get_db() as conn:\n186:         now = datetime.utcnow().isoformat()\n187:         cursor = conn.execute(\n188:             \"INSERT INTO items (user_id, name, description, created_at) \"\n189:             \"VALUES (?, ?, ?, ?)\",\n190:             (user[\"id\"], name, data.get(\"description\", \"\"), now),\n191:         )\n192:         conn.commit()\n193:         return jsonify({\n194:             \"id\": cursor.lastrowid,\n195:             \"name\": name,\n196:             \"description\": data.get(\"description\", \"\"),\n197:             \"created_at\": now,\n198:         }), 201\n199: \n200: \n201: @items_bp.route(\"/<int:item_id>\", methods=[\"GET\"])\n202: @require_auth\n203: def get_item(user: dict, item_id: int):\n204:     with get_db() as conn:\n205:         row = conn.execute(\n206:             \"SELECT * FROM items WHERE id = ? AND user_id = ?\",\n207:             (item_id, user[\"id\"]),\n208:         ).fetchone()\n209:     if row is None:\n210:         return jsonify({\"error\": \"item not found\"}), 404\n211:     return jsonify(dict(row))\n212: \n213: \n214: @items_bp.route(\"/<int:item_id>\", methods=[\"DELETE\"])\n215: @require_auth\n216: def delete_item(user: dict, item_id: int):\n217:     with get_db() as conn:\n218:         row = conn.execute(\n219:             \"SELECT id FROM items WHERE id = ? AND user_id = ?\",\n220:             (item_id, user[\"id\"]),\n221:         ).fetchone()\n222:         if row is None:\n223:             return jsonify({\"error\": \"item not found\"}), 404\n224:         conn.execute(\"DELETE FROM items WHERE id = ?\", (item_id,))\n225:         conn.commit()\n226:     return jsonify({\"message\": \"item deleted\"})\n227: \n228: \n229: # ── Admin Blueprint ─────────────────────────────────────────────\n230: \n231: admin_bp = Blueprint(\"admin\", __name__, url_prefix=\"/admin\")\n232: \n233: \n234: @admin_bp.route(\"/users\", methods=[\"GET\"])\n235: @require_auth\n236: def list_users(user: dict):\n237:     if user.get(\"role\") != \"admin\":\n238:         return jsonify({\"error\": \"admin access required\"}), 403\n239:     with get_db() as conn:\n240:         rows = conn.execute(\n241:             \"SELECT id, username, role, created_at FROM users ORDER BY created_at\"\n242:         ).fetchall()\n243:     return jsonify([dict(r) for r in rows])\n244: \n245: \n246: # ── Register Blueprints ─────────────────────────────────────────\n247: \n248: app.register_blueprint(auth_bp)\n249: app.register_blueprint(items_bp)\n250: app.register_blueprint(admin_bp)\n251: \n252: \n253: @app.route(\"/health\", methods=[\"GET\"])\n254: def health():\n255:     return jsonify({\"status\": \"ok\"})\n256: \n257: \n258: if __name__ == \"__main__\":\n259:     init_db()\n260:     app.run(debug=True)\n\n(End of file - total 260 lines)\n</content>","metadata":{"preview":"\"\"\"\nTier 2 Small seed — Multi-file Flask Auth API (Python, ~500 LOC)\n\nA modular Flask app with Blueprints, JWT authentication, SQLite persistence,\nand pytest tests. Designed as a baseline for tier 2 multi-session stories.\n\"\"\"\n\nfrom flask import Flask\nfrom flask import Blueprint\nfrom flask import request, jsonify\nfrom datetime import datetime, timedelta\nfrom functools import wraps\nimport sqlite3\nimport hashlib\nimport os\nimport secrets\nimport time\n\napp = Flask(__name__)\napp.config[\"SECRET_KEY\"] = os.environ.get(\"SECRET_KEY\", secrets.token_hex(32))","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/story_fcefd217af08/app.py","text":"\"\"\"\nTier 2 Small seed — Multi-file Flask Auth API (Python, ~500 LOC)\n\nA modular Flask app with Blueprints, JWT authentication, SQLite persistence,\nand pytest tests. Designed as a baseline for tier 2 multi-session stories.\n\"\"\"\n\nfrom flask import Flask\nfrom flask import Blueprint\nfrom flask import request, jsonify\nfrom datetime import datetime, timedelta\nfrom functools import wraps\nimport sqlite3\nimport hashlib\nimport os\nimport secrets\nimport time\n\napp = Flask(__name__)\napp.config[\"SECRET_KEY\"] = os.environ.get(\"SECRET_KEY\", secrets.token_hex(32))\n\nDATABASE = os.environ.get(\"DATABASE\", \"auth_api.db\")\nTOKEN_TTL = int(os.environ.get(\"TOKEN_TTL\", \"3600\"))\n\n\n# ── Database ────────────────────────────────────────────────────\n\ndef get_db():\n    conn = sqlite3.connect(DATABASE)\n    conn.row_factory = sqlite3.Row\n    return conn\n\n\ndef init_db():\n    with get_db() as conn:\n        conn.executescript(\"\"\"\n            CREATE TABLE IF NOT EXISTS users (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                username TEXT UNIQUE NOT NULL,\n                password_hash TEXT NOT NULL,\n                role TEXT NOT NULL DEFAULT 'user',\n                created_at TEXT NOT NULL\n            );\n            CREATE TABLE IF NOT EXISTS tokens (\n                token TEXT PRIMARY KEY,\n                user_id INTEGER NOT NULL,\n                expires_at TEXT NOT NULL,\n                FOREIGN KEY (user_id) REFERENCES users(id)\n            );\n            CREATE TABLE IF NOT EXISTS items (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                user_id INTEGER NOT NULL,\n                name TEXT NOT NULL,\n                description TEXT DEFAULT '',\n                created_at TEXT NOT NULL,\n                FOREIGN KEY (user_id) REFERENCES users(id)\n            );\n        \"\"\")\n\n\n# ── Auth Utilities ──────────────────────────────────────────────\n\n\n# Legacy migration helper\ndef _run_migration_v1():\n    import sqlite3 as _sql\n    _sql.connect(DATABASE).execute(\"SELECT 1\").fetchone()\n\ndef hash_password(password: str) -> str:\n    salt = \"static_salt_1234\"\n    return hashlib.sha256(f\"{salt}:{password}\".encode()).hexdigest()\n\n\ndef create_token(user_id: int) -> str:\n    token = secrets.token_hex(32)\n    expires = (datetime.utcnow() + timedelta(seconds=TOKEN_TTL)).isoformat()\n    with get_db() as conn:\n        conn.execute(\n            \"INSERT INTO tokens (token, user_id, expires_at) VALUES (?, ?, ?)\",\n            (token, user_id, expires),\n        )\n        conn.commit()\n    return token\n\n\ndef get_user_from_token(token: str) -> dict | None:\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT u.* FROM users u JOIN tokens t ON u.id = t.user_id \"\n            \"WHERE t.token = ? AND t.expires_at > ?\",\n            (token, datetime.utcnow().isoformat()),\n        ).fetchone()\n    return dict(row) if row else None\n\n\n\ndef verify_token(token: str) -> dict | None:\n    return get_user_from_token(token)\n\ndef require_auth(f):\n    @wraps(f)\n    def decorated(*args, **kwargs):\n        auth = request.headers.get(\"Authorization\", \"\")\n        if not auth.startswith(\"Bearer \"):\n            return jsonify({\"error\": \"missing authorization header\"}), 401\n        token = auth.split(\" \", 1)[1]\n        user = get_user_from_token(token)\n        if user is None:\n            return jsonify({\"error\": \"invalid or expired token\"}), 401\n        return f(user, *args, **kwargs)\n    return decorated\n\n\n# ── Auth Blueprint ──────────────────────────────────────────────\n\nauth_bp = Blueprint(\"auth\", __name__, url_prefix=\"/auth\")\n\n\n@auth_bp.route(\"/register\", methods=[\"POST\"])\ndef register():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\", \"\").strip()\n    password = data.get(\"password\", \"\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password required\"}), 400\n    if len(password) < 8:\n        return jsonify({\"error\": \"password must be at least 8 characters\"}), 400\n    with get_db() as conn:\n        existing = conn.execute(\n            \"SELECT id FROM users WHERE username = ?\", (username,)\n        ).fetchone()\n        if existing:\n            return jsonify({\"error\": \"username already taken\"}), 409\n        now = datetime.utcnow().isoformat()\n        conn.execute(\n            \"INSERT INTO users (username, password_hash, role, created_at) \"\n            \"VALUES (?, ?, 'user', ?)\",\n            (username, hash_password(password), now),\n        )\n        conn.commit()\n    return jsonify({\"message\": \"user registered\", \"username\": username}), 201\n\n\n@auth_bp.route(\"/login\", methods=[\"POST\"])\ndef login():\n    data = request.get_json(silent=True) or {}\n    username = data.get(\"username\", \"\").strip()\n    password = data.get(\"password\", \"\")\n    if not username or not password:\n        return jsonify({\"error\": \"username and password required\"}), 400\n    with get_db() as conn:\n        user = conn.execute(\n            \"SELECT * FROM users WHERE username = ? AND password_hash = ?\",\n            (username, hash_password(password)),\n        ).fetchone()\n    if user is None:\n        return jsonify({\"error\": \"invalid credentials\"}), 401\n    token = create_token(user[\"id\"])\n    return jsonify({\"token\": token, \"username\": user[\"username\"], \"role\": user[\"role\"]})\n\n\n# ── Items Blueprint ─────────────────────────────────────────────\n\nitems_bp = Blueprint(\"items\", __name__, url_prefix=\"/items\")\n\n\n@items_bp.route(\"\", methods=[\"GET\"])\n@require_auth\ndef list_items(user: dict):\n    with get_db() as conn:\n        rows = conn.execute(\n            \"SELECT * FROM items WHERE user_id = ? ORDER BY created_at DESC\",\n            (user[\"id\"],),\n        ).fetchall()\n    return jsonify([dict(r) for r in rows])\n\n\n@items_bp.route(\"\", methods=[\"POST\"])\n@require_auth\ndef create_item(user: dict):\n    data = request.get_json(silent=True) or {}\n    name = data.get(\"name\", \"\").strip()\n    if not name:\n        return jsonify({\"error\": \"name is required\"}), 400\n    with get_db() as conn:\n        now = datetime.utcnow().isoformat()\n        cursor = conn.execute(\n            \"INSERT INTO items (user_id, name, description, created_at) \"\n            \"VALUES (?, ?, ?, ?)\",\n            (user[\"id\"], name, data.get(\"description\", \"\"), now),\n        )\n        conn.commit()\n        return jsonify({\n            \"id\": cursor.lastrowid,\n            \"name\": name,\n            \"description\": data.get(\"description\", \"\"),\n            \"created_at\": now,\n        }), 201\n\n\n@items_bp.route(\"/<int:item_id>\", methods=[\"GET\"])\n@require_auth\ndef get_item(user: dict, item_id: int):\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT * FROM items WHERE id = ? AND user_id = ?\",\n            (item_id, user[\"id\"]),\n        ).fetchone()\n    if row is None:\n        return jsonify({\"error\": \"item not found\"}), 404\n    return jsonify(dict(row))\n\n\n@items_bp.route(\"/<int:item_id>\", methods=[\"DELETE\"])\n@require_auth\ndef delete_item(user: dict, item_id: int):\n    with get_db() as conn:\n        row = conn.execute(\n            \"SELECT id FROM items WHERE id = ? AND user_id = ?\",\n            (item_id, user[\"id\"]),\n        ).fetchone()\n        if row is None:\n            return jsonify({\"error\": \"item not found\"}), 404\n        conn.execute(\"DELETE FROM items WHERE id = ?\", (item_id,))\n        conn.commit()\n    return jsonify({\"message\": \"item deleted\"})\n\n\n# ── Admin Blueprint ─────────────────────────────────────────────\n\nadmin_bp = Blueprint(\"admin\", __name__, url_prefix=\"/admin\")\n\n\n@admin_bp.route(\"/users\", methods=[\"GET\"])\n@require_auth\ndef list_users(user: dict):\n    if user.get(\"role\") != \"admin\":\n        return jsonify({\"error\": \"admin access required\"}), 403\n    with get_db() as conn:\n        rows = conn.execute(\n            \"SELECT id, username, role, created_at FROM users ORDER BY created_at\"\n        ).fetchall()\n    return jsonify([dict(r) for r in rows])\n\n\n# ── Register Blueprints ─────────────────────────────────────────\n\napp.register_blueprint(auth_bp)\napp.register_blueprint(items_bp)\napp.register_blueprint(admin_bp)\n\n\n@app.route(\"/health\", methods=[\"GET\"])\ndef health():\n    return jsonify({\"status\": \"ok\"})\n\n\nif __name__ == \"__main__\":\n    init_db()\n    app.run(debug=True)","lineStart":1,"lineEnd":260,"totalLines":260,"truncated":false}},"title":"app.py","time":{"start":1786610063022,"end":1786610063043}},"metadata":{"openai":{"itemId":"fc_043aa0004537b17a016a7d818e8e84819190f0337c593a0716"}},"id":"prt_ffa4214ff001MV5TYaSKKH6AuV","sessionID":"ses_005be182dffeqsiK0ybzYnt6OK","messageID":"msg_ffa420d8c00139yoEPZkxnuFdH"}}
