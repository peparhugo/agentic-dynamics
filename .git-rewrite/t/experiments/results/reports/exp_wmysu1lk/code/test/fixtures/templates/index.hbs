<!DOCTYPE html>
<html>
<head>
  <title>{{site.title}}</title>
</head>
<body>
  {{> header}}
  <h1>{{site.title}}</h1>
  <ul>
  {{#each posts}}
    <li>
      <a href="/posts/{{slug}}/index.html">{{title}}</a>
      <time>{{date}}</time>
      {{#each tags}}<span class="tag">{{this}}</span>{{/each}}
    </li>
  {{/each}}
  </ul>
  <footer>&copy; {{site.author}}</footer>
</body>
</html>
