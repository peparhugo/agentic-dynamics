<article>
  <h1>{{page.title}}</h1>
  {{#if page.date}}<time datetime="{{page.date}}">{{page.date}}</time>{{/if}}
  <div class="content">{{{content}}}</div>
  {{#if page.tags}}
  <ul class="tags">
    {{#each page.tags}}
      <li><a href="/tags/{{this}}/">#{{this}}</a></li>
    {{/each}}
  </ul>
  {{/if}}
</article>
