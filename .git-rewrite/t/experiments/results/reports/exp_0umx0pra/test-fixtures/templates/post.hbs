<article>
  <h1>{{page.frontmatter.title}}</h1>
  {{#if page.frontmatter.date}}
  <time>{{formatDate page.frontmatter.date}}</time>
  {{/if}}
  {{#if page.tags}}
  <ul class="tags">
    {{#each page.tags}}
    <li><a href="/tags/{{this}}/">{{this}}</a></li>
    {{/each}}
  </ul>
  {{/if}}
  {{{content}}}
</article>
