{
  "name": "sitegen",
  "version": "0.1.0",
  "description": "Static site generator: Markdown + Handlebars -> HTML, with tags, RSS, and live-reload dev server",
  "type": "module",
  "bin": {
    "sitegen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "marked-highlight": "^2.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
