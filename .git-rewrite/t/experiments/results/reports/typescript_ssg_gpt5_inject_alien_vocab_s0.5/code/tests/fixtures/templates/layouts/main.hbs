<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{{#if page.frontmatter.title}}{{page.frontmatter.title}} – {{/if}}{{site.title}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <style>
      body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Noto Sans,sans-serif;max-width:800px;margin:2rem auto;padding:0 1rem;}
      header, footer{color:#666}
      pre{background:#111;color:#eee;padding:1rem;overflow:auto;border-radius:6px}
      code{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace}
      a{color:#0a58ca;text-decoration:none} a:hover{text-decoration:underline}
