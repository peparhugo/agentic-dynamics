<article>
  <h1>{{page.frontmatter.title}}</h1>
  {{#if page.frontmatter.date}}
    <p><time datetime="{{formatDate page.frontmatter.date}}">{{formatDate page.frontmatter.date}}</time></p>
  {{/if}}
  <div class="content">{{{content}}}</div>
  {{#if page.frontmatter.tags}}
    <p>Tags:
      {{#each page.frontmatter.tags}}
        <a href="/tags/{{this}}/">#{{this}}</a>
      {{/each}}
    </p>
  {{/if}}
</article>
