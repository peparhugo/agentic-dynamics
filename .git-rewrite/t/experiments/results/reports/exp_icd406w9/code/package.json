{
  "name": "ssg",
  "version": "1.0.0",
  "description": "Static site generator: Markdown + YAML frontmatter -> Handlebars -> HTML",
  "type": "module",
  "bin": { "ssg": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts serve"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "chokidar": "^3.6.0",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
