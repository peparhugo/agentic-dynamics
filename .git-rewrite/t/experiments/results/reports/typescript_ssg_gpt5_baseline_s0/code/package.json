{
  "name": "ts-ssg-cli",
  "version": "0.1.0",
  "description": "A simple static site generator CLI in TypeScript (Markdown + Handlebars)",
  "bin": {
    "ssg": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "dev": "npm run build -- --watch"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.9.0",
    "markdown-it": "^13.0.2",
    "mime-types": "^2.1.35",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.8",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
