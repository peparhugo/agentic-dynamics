{
  "name": "ts-ssg",
  "version": "0.1.0",
  "description": "A TypeScript static site generator CLI with Handlebars templates, frontmatter, tags, RSS, and live reload dev server.",
  "main": "dist/cli.js",
  "bin": {
    "ts-ssg": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "vite-node src/cli.ts -- --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "static-site-generator",
    "ssg",
    "typescript",
    "handlebars",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.1.0",
    "mime": "^4.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.3",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^22.5.2",
    "rimraf": "^5.0.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "vite-node": "^2.0.5"
  }
}
