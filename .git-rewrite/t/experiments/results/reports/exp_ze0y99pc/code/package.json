{
  "name": "statick",
  "version": "1.0.0",
  "description": "A static site generator CLI",
  "main": "dist/index.js",
  "bin": {
    "statick": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/main.js",
    "dev": "tsc && node dist/cli/main.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "rss": "^1.2.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
