{
  "name": "staticsmith",
  "version": "1.0.0",
  "description": "Static site generator with Markdown, Handlebars, live reload, RSS, and syntax highlighting",
  "main": "dist/index.js",
  "bin": {
    "staticsmith": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node dist/index.js dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.0",
    "marked-highlight": "^2.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
