{
  "name": "triton",
  "version": "1.0.0",
  "description": "A static site generator CLI in TypeScript",
  "main": "dist/index.js",
  "bin": {
    "triton": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["static-site-generator", "ssg", "markdown", "handlebars"],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.10.0",
    "marked": "^14.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
