</div></section>

<!-- S9: THE RULEBOOK -->
<section class="slide s9" id="s9"><div class="inr wide">
<div class="pulse">09 · The Rulebook</div>
<h2>Start silent. Validate automatically.<br>Escalate by exception.</h2>
<div class="cards" style="margin:1.5rem 0">
<div class="card gn"><div class="cname">Default Route</div><div class="cval gn">$0.016</div><div class="csub">per session · 1,873 builds/$</div><div class="ctag gn">DeepSeek v4 Pro</div><div class="detail">Use for constrained tasks with pinned frameworks, explicit dependencies, and automated tests. Silent mode by default. 61% pass rate (100% with Flask-only prompts). <strong>Best cost-per-outcome ratio across all domains.</strong></div></div>
<div class="card ac"><div class="cname">Fallback Routes</div><div class="cval ac">$0.001</div><div class="csub">per session · 100% pass</div><div class="ctag ac">GPT-5-mini / nano</div><div class="detail">Use when standardized tests fit the task and absolute cost floor matters. Both achieved 100% pass rates at $0.001/session. GPT-5-mini has highest Explanation Tax (119.6%) — use forced-silent mode to cut costs by 55%.</div></div>
<div class="card am"><div class="cname">Premium Escalation</div><div class="cval am">$0.010–$0.249</div><div class="csub">per session · 100% pass</div><div class="ctag am">GPT-5.6 / Claude</div><div class="detail">Escalate when lower-cost routes fail acceptance gates, architecture is ambiguous, or auditable explanation is required for compliance. Both deliver 100% pass rates. Claude for highest-stakes critical paths.</div></div>
</div>
<div class="stats" style="margin-top:1rem"><div class="stat"><div class="v gn">$3,476</div><div class="l">Monthly Savings</div><div class="s">10-engineer team: DS $72 vs Claude $3,548 at 2024 prices</div></div><div class="stat"><div class="v am">$4,172</div><div class="l">2030 Monthly Gap</div><div class="s">Wider with 1.2× EPM — cheaper models compound energy savings</div></div><div class="stat"><div class="v ac">30-Day</div><div class="l">Pilot Plan</div><div class="s">Week 1: Classify · Week 2: Route to DS · Week 3: Add fallbacks · Week 4: Report metrics</div></div></div>
<div class="risk-box" style="margin-top:1.5rem"><span class="icon">⚠️</span><div><strong>Risk Awareness:</strong> This framework is based on 8 models, 250+ test sessions, 139 worktrees, and IEA/EIA energy projections. Your results may vary by task domain and environment. We recommend A/B testing routing rules in your own environment before committing to long-term model contracts. DeepSeek's 61% pass rate improves to 100% when frameworks and dependencies are explicitly pinned. Use CostPerOutcome, not per-session price, as your north star metric.</div></div>
<div class="cta-bar" style="margin-top:1.5rem"><a href="https://github.com/peparhugo/reasoning-instrument" class="cta-btn">View Full Research on GitHub</a><a href="#s0" class="cta-btn ghost">Back to Top ↑</a></div>
<div class="refs" style="text-align:center"><strong>Energy Sources:</strong> IEA 2025 · Goldman Sachs 2026 (220% AI power demand) · EIA 2026 (6.7–12% US generation) · Carnegie Mellon 2025 · Rystad Energy 2025<br><strong>Research:</strong> Liu et al. (2026) · TokenPowerBench (AAAI 2026) · Zhu & Zhu (2026) · CARL (ACL 2026) · TRACED (2026)<br><strong>The Silent Inference Principle · AI Cost-Efficiency Rulebook (Alpha) · August 2026</strong></div>
</div></section>

<script>
// Nav dot tracking
const dots = document.querySelectorAll('.nav-dots a');
const slides = document.querySelectorAll('.slide');
new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(e.isIntersecting) dots.forEach(d => d.classList.toggle('active', d.getAttribute('href')==='#'+e.target.id));
  });
}, {threshold:0.5}).observe ? null : slides.forEach(s => new IntersectionObserver(entries => {
  entries.forEach(e => {if(e.isIntersecting) dots.forEach(d => d.classList.toggle('active', d.getAttribute('href')==='#'+e.target.id));});
}, {threshold:0.5}).observe(s));
slides.forEach(s => new IntersectionObserver(entries => {
  entries.forEach(e => {if(e.isIntersecting) dots.forEach(d => d.classList.toggle('active', d.getAttribute('href')==='#'+e.target.id));});
}, {threshold:0.5}).observe(s));

dots.forEach(d => d.addEventListener('click', e => {
  e.preventDefault();
  document.querySelector(d.getAttribute('href')).scrollIntoView({behavior:'smooth'});
}));

// ROI Calculator
const epmLevels = [1.00, 1.08, 1.20, 1.38, 1.80];
const epmLabels = ['2024 (1.00×)', '2026 (1.08×)', '2030 (1.20×)', '2035 (1.38×)', '2050 (1.80×)'];
const models = [{n:'DeepSeek v4 Pro',c:0.016,p:0.61},{n:'Claude Fable 5',c:0.249,p:1.0},{n:'GPT-5.6',c:0.464,p:1.0},{n:'GPT-5-mini',c:0.060,p:1.0}];

function updateROI(){
  const E=+document.getElementById('r_eng').value;
  const S=+document.getElementById('r_ses').value;
  const V=+document.getElementById('r_vel').value;
  const D=+document.getElementById('r_day').value;
  const ei=+document.getElementById('r_epm').value;
  const HC=+document.getElementById('r_cost').value;
  const EPM=epmLevels[ei];
  document.getElementById('v_eng').textContent=E;
  document.getElementById('v_ses').textContent=S;
  document.getElementById('v_vel').textContent=V;
  document.getElementById('v_day').textContent=D;
  document.getElementById('v_epm').textContent=epmLabels[ei];
  document.getElementById('v_cost').textContent='$'+HC.toLocaleString();
  const N=S*D, B=0.001;
  let html='';
  models.forEach(m => {
    const cm=E*m.c*EPM*(N+B*V*N*(N-1)/2);
    const vs=E*N*0.25*HC/160;
    const roi=vs-cm;
    html+=`<div class="o"><div class="ov ${cm<100?'gn':cm<1000?'am':'rd'}">$${cm.toFixed(0)}</div><div class="ol">${m.n}/mo</div></div>`;
  });
  document.getElementById('roi_output').innerHTML=html;
}

// Cumulative Cost Chart
let chart;
function buildChart(){
  const ctx=document.getElementById('costChart');
  if(!ctx) return;
  const months=Array.from({length:37},(_,i)=>i); // 0-36 months
  const E=10,S=20,D=20,V=500,B=0.001,EPM=1.0;
  const NpM=S*D;
  const cum=(c,P)=>{
    let tot=0;
    return months.map(m=>{
      const N=m*NpM;
      tot=c*EPM*(N+B*V*N*(N-1)/2)*E;
      return tot;
    });
  };
  if(chart) chart.destroy();
  chart=new Chart(ctx,{
    type:'line',
    data:{
      labels:months.map(m=>'Month '+m),
      datasets:[
        {label:'DeepSeek v4 Pro ($0.016/session)',data:cum(0.016,0.61),borderColor:'#10b981',backgroundColor:'rgba(16,185,129,0.1)',fill:true,tension:0.3,borderWidth:2,pointRadius:0},
        {label:'GPT-5-mini ($0.060/session)',data:cum(0.060,1.0),borderColor:'#3b82f6',backgroundColor:'rgba(59,130,246,0.05)',fill:true,tension:0.3,borderWidth:2,pointRadius:0},
        {label:'Claude Fable 5 ($0.249/session)',data:cum(0.249,1.0),borderColor:'#ef4444',backgroundColor:'rgba(239,68,68,0.05)',fill:true,tension:0.3,borderWidth:2,pointRadius:0},
        {label:'GPT-5.6 ($0.464/session)',data:cum(0.464,1.0),borderColor:'#f59e0b',backgroundColor:'rgba(245,158,11,0.05)',fill:true,tension:0.3,borderWidth:2,pointRadius:0},
      ]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{color:'#9ca3af',font:{size:11},padding:16,usePointStyle:true}}},
      scales:{
        x:{ticks:{color:'#6b7280',font:{size:10},maxTicksLimit:12},grid:{color:'rgba(255,255,255,0.04)'}},
        y:{ticks:{color:'#6b7280',font:{size:10},callback:v=>'$'+v.toLocaleString()},grid:{color:'rgba(255,255,255,0.04)'}}
      },
      interaction:{intersect:false,mode:'index'}
    }
  });
}
document.addEventListener('DOMContentLoaded',()=>{updateROI();buildChart();});
</script>
</body>
</html>
