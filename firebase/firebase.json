{
  "hosting": {
    "public": "../apps/website",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
        ]
      }
    ],
    "redirects": [
      {"source": "/instrument.html", "destination": "/methodology.html", "type": 301},
      {"source": "/applications.html", "destination": "/accelerator.html", "type": 301},
      {"source": "/related-work.html", "destination": "/databricks.html", "type": 301}
    ]
  }
}