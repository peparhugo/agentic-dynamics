# agentic-dynamics-launch-broker.service — the launch broker, running where the socket is (fb2_broker_hostside).
#
# A systemd USER unit, following the docs-drift-scan.service precedent
# (~/.config/systemd/user/) rather than the system-wide fleet-bootstrap.service: the broker is
# the operator's own host-side component that holds the Docker socket. It is the ONLY Docker
# API caller in the fleet — every cell launch / fleet command the orchestrator needs is emitted
# over the broker's unix-socket IPC seam (scripts/fleet/broker_client.py), and NO container
# mounts the docker socket. This unit IS the docker socket's only home.
#
# The unit runs `scripts/fleet/launch_broker.py serve` as a long-running daemon: it binds the
# seam socket (a unix socket under the user runtime dir, %t = $XDG_RUNTIME_DIR), accepts one
# framed typed request per connection, validates it against the shared contract
# (broker_contract.py), and performs the docker/compose call itself. Type=simple +
# Restart=on-failure: the daemon has no natural end, and a crashed broker must come back (a
# stopped broker is a loud spawn failure — clients raise, never silently pass).
#
# The docker socket (/var/run/docker.sock) is read via the operator user's docker-group
# membership (the same access `docker` from this login has) — the broker process is the host
# user, never root, and never a container.
#
# Install (as the operator, NOT root):
#   mkdir -p ~/.config/systemd/user
#   cp infrastructure/agentic-dynamics-launch-broker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentic-dynamics-launch-broker.service
#   loginctl enable-linger "$USER"      # so the daemon survives logout
#
# Inspect:
#   systemctl --user status agentic-dynamics-launch-broker
#   journalctl --user -u agentic-dynamics-launch-broker -n 50
#
# Smoke (a synthetic cell spawn request round-trips through the host broker — the unit suite
# drives the same round-trip against a stubbed docker binary, tests/test_broker_hostside.py):
#   python3 -m pytest tests/test_broker_hostside.py -q
#   # live seam liveness check:
#   python3 -c "import sys; sys.path.insert(0, 'scripts/fleet'); import broker_client; \
# print(broker_client.BrokerClient().ping())"

[Unit]
Description=Agentic-dynamics launch broker — the host-side Docker-socket holder + typed IPC seam
Documentation=file:///home/drseuss/ai-finops-framework/workflows/repository/fleet_launch_boundary_followups.yaml
# Wants=, not Requires=: the broker's validation + launch logic needs no other unit; it is the
# socket's home and nothing upstream of it must gate its start. After=network-online.target
# because the broker may launch cells that reach model APIs through the egress proxy.
After=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5

# The deployed checkout. Update REPO if the framework lives elsewhere on this host.
Environment=REPO=/home/drseuss/ai-finops-framework
WorkingDirectory=/home/drseuss/ai-finops-framework

# The docker/compose binaries the broker executes (its own PATH is the unit's default).
Environment=FINOPS_DOCKER_BIN=docker
Environment=FINOPS_DOCKER_COMPOSE_BIN=docker-compose

# The seam socket lives under the user runtime dir (%t = $XDG_RUNTIME_DIR) — the SAME path
# broker_client.default_socket_path() resolves to for a host-side client in this user session.
ExecStart=/usr/bin/env python3 scripts/fleet/launch_broker.py serve --socket %t/launch-broker.sock

# A docker run for a cell can legitimately take hours (a 4h adversarial phase); the broker's
# own per-request subprocess timeout is bounded by the typed request's timeout_seconds. This
# ceiling only bounds a wedged accept loop, never a legitimate long launch.
TimeoutStartSec=60

# Least privilege for a unit whose whole job is to run docker as the operator: no new
# privileges, no control-group/kernel surface, no setuid binaries. The docker socket is
# reached through the operator's docker-group membership, not through root.
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
