# fleet-bootstrap.service — the host's ONE bootstrap unit (proposal §2/§4, D-9).
#
# The host's footprint of ours is the docker daemon + this unit: it brings up the
# supervisor (fleet-manager) container and nothing else. Everything else is a container on
# the ladder, or the operator's chat. The supervisor's own liveness is the COMPOSE restart
# policy on the fleet-manager service (`restart: always` in docker-compose.ladder.yml) —
# not a systemd Restart=: systemd rejects `Restart=always` on a Type=oneshot unit
# ("Service has Restart= set to either always or on-success, which isn't allowed for
# Type=oneshot"), and `docker-compose up -d` exits after creating the container, so a
# Type=simple unit would be considered dead and restart-loop. oneshot + RemainAfterExit runs
# the bring-up exactly once at boot, keeps the unit `active (exited)` as the host's record of
# it, and ExecStop tears the container down on `systemctl stop`.
#
# Install (as root):
#   cp infrastructure/fleet-bootstrap.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now fleet-bootstrap

[Unit]
Description=Fleet ladder supervisor (fleet-manager) — the host's one bootstrap unit
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The compose file lives in the deployed repo (update REPO to the checkout path).
Environment=REPO=/home/drseuss/ai-finops-framework
# fleet-net is external (D-17): create it if absent, then bring up the supervisor.
ExecStartPre=-/usr/bin/docker network create fleet-net
ExecStart=/usr/bin/docker-compose -f ${REPO}/infrastructure/docker-compose.ladder.yml up -d fleet-manager
ExecStop=/usr/bin/docker-compose -f ${REPO}/infrastructure/docker-compose.ladder.yml stop fleet-manager

[Install]
WantedBy=multi-user.target
