{
  "name": "ts-ssg",
  "version": "0.1.0",
  "description": "A simple static site generator CLI in TypeScript",
  "bin": {
    "ssg": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rimraf dist",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
