<h1>Posts</h1>
<ul>
  {{#each posts}}
  <li>
    <a href="/{{slug}}.html">{{frontmatter.title}}</a>
    {{#if frontmatter.date}}<span>({{formatDate frontmatter.date}})</span>{{/if}}
  </li>
  {{/each}}
</ul>

{{#if tags}}
<h2>Tags</h2>
<ul>
  {{#each tags}}
  <li><a href="/tags/{{@key}}.html">{{@key}}</a> ({{this.length}})</li>
  {{/each}}
</ul>
{{/if}}
