{
  "name": "staticsmith",
  "version": "1.0.0",
  "description": "A static site generator supporting Markdown + Handlebars with live reload",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "staticsmith": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.8",
    "marked-highlight": "^2.2.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
