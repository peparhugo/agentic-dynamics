<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
</head>
<body>
  <header>
    <h1><a href="/">{{title}}</a></h1>
  </header>
  <main>
    {{{content}}}
  </main>
  <footer>
    {{#each tags}}
      <a href="/tags/{{this}}/">{{this}}</a>
    {{/each}}
  </footer>
</body>
</html>
