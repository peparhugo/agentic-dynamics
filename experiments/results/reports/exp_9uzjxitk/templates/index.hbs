<h1>{{title}}</h1>
{{#each posts}}
<article>
  <h2><a href="{{../site.baseUrl}}/{{slug}}.html">{{frontmatter.title}}</a></h2>
  <time datetime="{{frontmatter.date}}">{{dateFormat frontmatter.date}}</time>
  {{#if frontmatter.tags}}
  <ul class="tags">
    {{#each frontmatter.tags}}
    <li><a href="{{../../site.baseUrl}}/tags/{{encodeURI this}}/">#{{this}}</a></li>
    {{/each}}
  </ul>
  {{/if}}
</article>
{{/each}}
