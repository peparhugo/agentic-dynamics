{{#with page}}
<article>
  <h1>{{frontmatter.title}}</h1>
  <time datetime="{{frontmatter.date}}">{{dateFormat frontmatter.date}}</time>
  {{#if frontmatter.tags}}
  <ul class="tags">
    {{#each frontmatter.tags}}
    <li><a href="{{@root.site.baseUrl}}/tags/{{encodeURI this}}/">#{{this}}</a></li>
    {{/each}}
  </ul>
  {{/if}}
  <div>
    {{{html}}}
  </div>
</article>
{{/with}}
