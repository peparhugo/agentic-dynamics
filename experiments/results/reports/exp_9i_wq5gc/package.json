{
  "name": "ts-ssg",
  "version": "0.1.0",
  "description": "A TypeScript static site generator CLI with Handlebars, frontmatter, tags, RSS, dev server, and live reload.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "ssg": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "ws": "^8.18.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.7",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20.11.21",
    "@types/ws": "^8.5.10",
    "@types/yargs": "^17.0.32",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
