<!DOCTYPE html>
<html>
<head><title>{{title}}</title></head>
<body>
  <h1>{{title}}</h1>
  {{#each pages}}
    <article>
      <h2><a href="/{{slug}}.html">{{frontmatter.title}}</a></h2>
      {{#if frontmatter.date}}<time>{{frontmatter.date}}</time>{{/if}}
    </article>
  {{/each}}
</body>
</html>
