{
  "name": "staticsmith",
  "version": "1.0.0",
  "description": "A static site generator CLI",
  "main": "dist/index.js",
  "bin": {
    "staticsmith": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsc && node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["static-site-generator", "markdown", "handlebars"],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "front-matter": "^4.0.2",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.0",
    "marked-highlight": "^2.1.3",
    "rss": "^1.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
