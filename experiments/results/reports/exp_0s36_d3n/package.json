{
  "name": "static-site-generator",
  "version": "1.0.0",
  "description": "Static site generator CLI with Markdown, Handlebars, live reload, and RSS",
  "main": "dist/index.js",
  "bin": {
    "ssg": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "handlebars-layouts": "^3.1.4",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.0",
    "marked-highlight": "^2.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.4",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
