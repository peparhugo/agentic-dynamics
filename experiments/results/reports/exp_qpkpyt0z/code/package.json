    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.9",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.3"
  }
}
