<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{page.title}} - {{site.title}}</title>
</head>
<body>
  {{> header}}
  <article>
    <h1>{{page.title}}</h1>
    {{#if page.date}}<time>{{formatDate page.date}}</time>{{/if}}
    {{#if page.tags}}
    <div class="tags">
      {{#each page.tags}}<a href="/tags/{{this}}/">{{this}}</a>{{/each}}
    </div>
    {{/if}}
    {{{content}}}
  </article>
</body>
</html>
