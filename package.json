{
  "name": "ssg",
  "version": "1.0.0",
  "description": "A small Markdown static site generator",
  "type": "commonjs",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "ssg": "build/cli.js"
  },
