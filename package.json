{
  "name": "ssg",
  "version": "1.0.0",
  "description": "A static site generator CLI built with TypeScript",
  "main": "dist/ssg.js",
  "bin": {
    "ssg": "dist/cli.entry.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --colors",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ssg",
    "static-site-generator",
    "markdown"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
