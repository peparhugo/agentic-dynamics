{
  "name": "ssg",
  "version": "1.0.0",
  "description": "A tiny static site generator CLI that turns Markdown files with HTML-comment frontmatter into a static site",
  "main": "dist/src/ssg.js",
  "bin": {
    "ssg": "dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ssg",
    "static-site-generator",
    "markdown"
  ],
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.10",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "marked": "^4.3.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.5.12",
    "@types/marked": "^4.3.2",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=14"
  }
}
