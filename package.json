{
  "name": "ssg",
  "version": "1.0.0",
  "description": "A static site generator CLI that renders Markdown with frontmatter into self-contained HTML pages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ssg": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "static-site-generator",
    "markdown",
    "ssg",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
